        ],
        "partitions": [
          {
            "name": "DQ_Rules",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "// Query: DQ_Rules  (generated by scripts/reference.py: documentation table shown on the Data Quality page)\nlet\n    Source = #table(\n        type table [RuleID = text, Check = text, Treatment = text, ExpectedCount = Int64.Type, ExpectedSales = Currency.Type],\n        {\n        {\"DQ01\", \"Lines with quantity = 0\", \"Kept: the value counts in Sales, the line adds no units; flagged 'Zero quantity'\", 8869, 12.52},\n        {\"DQ02\", \"Free items: quantity > 0 and sales_value = 0\", \"Kept: genuine promotional give-aways; flagged 'Free item'\", 2406, 0.0},\n        {\"DQ03\", \"Petrol lines: 'quantity' is not a unit count (up to 89,638 on one line)\", \"Kept in Sales and Fuel Sales; excluded from Units, Items per Basket and Avg Selling Price\", 14697, 384044.07},\n        {\"DQ04\", \"Product on a sales line is missing from the product file\", \"Kept; mapped to department UNKNOWN so no sales fall out of a department chart\", 4836, 172.57},\n        {\"DQ05\", \"Negative values (returns, voids)\", \"None found; the model does not handle returns\", 0, 0.0},\n        {\"DQ06\", \"Exact duplicate lines\", \"None found; no de-duplication step\", 0, 0.0},\n        {\"DQ07\", \"Calendar days with no transactions\", \"25 December only; flagged IsClosed; per-day measures divide by trading days\", 1, 0.0},\n        {\"DQ08\", \"Source week differs from the date table's week\", \"None; the date table reproduces the source's Monday-start weeks (week 1 = 1 January only)\", 0, 0.0}\n        }\n    )\nin\n    Source"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "_Measures",
        "lineageTag": "319f1d5d-7d8f-474e-b7e9-5af905343349",
        "columns": [
          {
            "name": "Column1",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Column1",
            "lineageTag": "7a7a6240-55dd-4f96-a3ed-7eec737c42d5",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "// Holds the measures only (Home > Enter data equivalent)\n#table(type table [Column1 = text], {})"
            }
          }
        ],
        "measures": [
          {
            "name": "Sales",
            "expression": "SUM ( Fact_Sales[sales_value] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "80cf76d5-5e0b-49e8-8846-9115a3f0a9ca",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Gross Sales",
            "expression": "SUM ( Fact_Sales[shelf_value] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "5894cb61-496c-4c54-8c1e-9b6792a90b3e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Retail Discount",
            "expression": "SUM ( Fact_Sales[retail_disc] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "b28f2977-90c9-4130-a953-609dd3b3e010",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Coupon Match Discount",
            "expression": "SUM ( Fact_Sales[coupon_match_disc] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "8feee408-874a-443b-836d-11ad35a6c606",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Total Discount",
            "expression": "[Retail Discount] + [Coupon Match Discount]",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "8b70fb63-3634-4d91-bbae-157e864b3307",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Discount %",
            "expression": "DIVIDE ( [Total Discount], [Gross Sales] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "242ab609-6174-4f21-98ed-b5e6432c44c5"
          },
          {
            "name": "Manufacturer Coupon Value",
            "expression": "SUM ( Fact_Sales[coupon_disc] )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "6b5f242b-7c95-42e3-9bd0-b9d2c66d832a",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Baskets",
            "expression": "DISTINCTCOUNT ( Fact_Sales[basket_id] )",
            "formatString": "#,0",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "5f02f868-0b3f-46bf-b5cb-cac57c25030f"
          },
          {
            "name": "Households",
            "expression": "DISTINCTCOUNT ( Fact_Sales[household_id] )",
            "formatString": "#,0",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "e1362d63-bf30-4bf8-a761-c275c7532ffb"
          },
          {
            "name": "Units",
            "expression": "CALCULATE ( SUM ( Fact_Sales[quantity] ), Dim_Product[IsFuel] = FALSE () )",
            "formatString": "#,0",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "b14a333c-7018-4415-9e25-9d41f92f5783"
          },
          {
            "name": "Sales ex Fuel",
            "expression": "CALCULATE ( [Sales], Dim_Product[IsFuel] = FALSE () )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "d8e04ca1-f1c1-4810-a25f-329170b33454",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Fuel Sales",
            "expression": "CALCULATE ( [Sales], Dim_Product[IsFuel] = TRUE () )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "87283d78-bc66-4b0f-956c-4d7db6d9a6c6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Avg Basket Value",
            "expression": "DIVIDE ( [Sales], [Baskets] )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "f3f61847-c717-47e2-9d24-06775877ac59",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Items per Basket",
            "expression": "DIVIDE ( [Units], CALCULATE ( [Baskets], Dim_Product[IsFuel] = FALSE () ) )",
            "formatString": "#,0.0",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "c0f1e1b3-52cd-477d-83c8-bcb3143b4b66"
          },
          {
            "name": "Avg Selling Price",
            "expression": "DIVIDE ( [Sales ex Fuel], [Units] )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "0cd609bf-dbfb-406d-9ebb-4944c4137384",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Private Label Share",
            "expression": "DIVIDE ( CALCULATE ( [Sales ex Fuel], Dim_Product[brand] = \"Private\" ), [Sales ex Fuel] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "2 Baskets and units",
            "lineageTag": "df0ecf3a-baef-4f00-8b73-4eefcdb6cbaa"
          },
          {
            "name": "Share of Total Sales",
            "expression": "DIVIDE ( [Sales], CALCULATE ( [Sales], REMOVEFILTERS ( Dim_Product ) ) )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "3 Mix and ranking",
            "lineageTag": "a0ea121d-8b12-4294-b926-64103fdb0841"
          },
          {
            "name": "Share of Department Sales",
            "expression": "DIVIDE (\n    [Sales],\n    CALCULATE ( [Sales], REMOVEFILTERS ( Dim_Product[product_category] ), REMOVEFILTERS ( Dim_Product[product_type] ) )\n)",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "3 Mix and ranking",
            "lineageTag": "33737ce1-b394-49aa-99af-5d0505bde622"
          },
          {
            "name": "Store Rank",
            "description": "Store measures rank and compare whole stores: ALLSELECTED over a sort-by column (store_label sorts by store_no) ranked every row 1 in Power BI Desktop, so these use the whole Dim_Store table. Blank on totals.",
            "expression": "IF ( HASONEVALUE ( Dim_Store[store_id] ), RANKX ( ALLSELECTED ( Dim_Store ), [Sales], , DESC, DENSE ) )",
            "formatString": "#,0",
            "displayFolder": "3 Mix and ranking",
            "lineageTag": "26fb5237-b71c-41d6-9535-b1035f623511"
          },
          {
            "name": "Sales vs Store Avg %",
            "expression": "IF (\n    HASONEVALUE ( Dim_Store[store_id] ),\n    DIVIDE ( [Sales], CALCULATE ( AVERAGEX ( VALUES ( Dim_Store[store_id] ), [Sales] ), REMOVEFILTERS ( Dim_Store ) ) ) - 1\n)",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "3 Mix and ranking",
            "lineageTag": "87bd39b2-067b-4bf1-b6e0-8f0f1d46d284"
          },
          {
            "name": "Discount % ex Fuel",
            "expression": "CALCULATE ( [Discount %], Dim_Product[IsFuel] = FALSE () )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "1 Sales and discounts",
            "lineageTag": "1f02501b-d4ee-4bd5-9937-265861a201e4"
          },
          {
            "name": "Discount % (depts over $10k)",
            "expression": "IF ( [Sales ex Fuel] >= 10000, [Discount % ex Fuel] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "7 Report helpers",
            "lineageTag": "897abce8-6f2c-4340-9a7f-800d02db6732"
          },
          {
            "name": "Private Label Share (depts over $10k)",
            "expression": "IF ( [Sales ex Fuel] >= 10000, [Private Label Share] )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "7 Report helpers",
            "lineageTag": "e9b68cd1-6207-4066-b68b-446fc33849b7"
          },
          {
            "name": "Retail Discount (depts over $10k)",
            "expression": "IF ( [Sales ex Fuel] >= 10000, CALCULATE ( [Retail Discount], Dim_Product[IsFuel] = FALSE () ) )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "7 Report helpers",
            "lineageTag": "be4fcc01-505e-4012-8bd1-7fe32cac080d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Coupon Match Discount (depts over $10k)",
            "expression": "IF ( [Sales ex Fuel] >= 10000, CALCULATE ( [Coupon Match Discount], Dim_Product[IsFuel] = FALSE () ) )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "7 Report helpers",
            "lineageTag": "70afbb67-30ee-4d6a-b339-59d4ad88a540",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Sales per Trading Day",
            "expression": "DIVIDE ( [Sales], CALCULATE ( COUNTROWS ( Dim_Date ), Dim_Date[IsClosed] = FALSE () ) )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "4 Time",
            "lineageTag": "6fb12a39-e736-4b0e-a473-4bc9c1cf6adc",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Sales PW",
            "expression": "VAR w = SELECTEDVALUE ( Dim_Date[WeekNo] )\nVAR prevIsFullWeek =\n    CALCULATE ( COUNTROWS ( Dim_Date ), ALL ( Dim_Date ), Dim_Date[WeekNo] = w - 1, Dim_Date[IsPartialWeek] = FALSE () )\nRETURN\n    IF ( ISBLANK ( w ) || ISBLANK ( prevIsFullWeek ), BLANK (), CALCULATE ( [Sales], ALL ( Dim_Date ), Dim_Date[WeekNo] = w - 1 ) )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "4 Time",
            "lineageTag": "1c97385a-c39e-4d21-b06d-906be580cb13",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Sales WoW %",
            "expression": "IF ( ISBLANK ( [Sales PW] ), BLANK (), DIVIDE ( [Sales] - [Sales PW], [Sales PW] ) )",
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "4 Time",
            "lineageTag": "e32055af-e3f0-4ba1-9847-86ae0a522842"
          },
          {
            "name": "Rolling 4 Week Sales",
            "expression": "VAR w = SELECTEDVALUE ( Dim_Date[WeekNo] )\nVAR window =\n    FILTER ( ALL ( Dim_Date ), Dim_Date[WeekNo] > w - 4 && Dim_Date[WeekNo] <= w && NOT ( Dim_Date[IsPartialWeek] ) )\nVAR fullWeeks = CALCULATE ( DISTINCTCOUNT ( Dim_Date[WeekNo] ), window )\nRETURN\n    IF ( ISBLANK ( w ) || fullWeeks < 4, BLANK (), CALCULATE ( [Sales], window ) )",
            "formatString": "\\$#,0;-\\$#,0;\\$#,0",
            "displayFolder": "4 Time",
            "lineageTag": "22a5cc5c-d825-40eb-a6eb-bc3a3bce4a1d",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Zero-Quantity Lines",
            "expression": "CALCULATE ( COUNTROWS ( Fact_Sales ), Fact_Sales[line_flag] = \"Zero quantity\" ) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "55563526-38b9-477e-a228-bd3d9e49a0ce"
          },
          {
            "name": "Zero-Quantity Sales",
            "expression": "CALCULATE ( [Sales], Fact_Sales[line_flag] = \"Zero quantity\" )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "5 Data quality",
            "lineageTag": "d2aec3ef-3247-4a48-a7a6-ed284f043704",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Free-Item Lines",
            "expression": "CALCULATE ( COUNTROWS ( Fact_Sales ), Fact_Sales[line_flag] = \"Free item\" ) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "d288ebdd-4492-4992-b4f8-17dd406dd405"
          },
          {
            "name": "Fuel Lines",
            "expression": "CALCULATE ( COUNTROWS ( Fact_Sales ), Dim_Product[IsFuel] = TRUE () ) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "ca7cdf1a-3b59-4851-93ef-8c00b1f83067"
          },
          {
            "name": "Unknown-Product Lines",
            "expression": "CALCULATE ( COUNTROWS ( Fact_Sales ), Dim_Product[department] = \"UNKNOWN\" ) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "2eea9451-b4b2-4248-be06-917da9236553"
          },
          {
            "name": "Unknown-Product Sales",
            "expression": "CALCULATE ( [Sales], Dim_Product[department] = \"UNKNOWN\" )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "5 Data quality",
            "lineageTag": "60d2f872-a73e-4104-b439-f025434d2210",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Source Week Mismatch Lines",
            "description": "Heavy (scans every line): keep these three on the Data Quality page only",
            "expression": "COUNTROWS ( FILTER ( Fact_Sales, Fact_Sales[source_week] <> RELATED ( Dim_Date[WeekNo] ) ) ) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "770773c6-44fd-4504-adc6-b6401e2a49c4"
          },
          {
            "name": "Negative-Value Lines",
            "expression": "COUNTROWS (\n    FILTER (\n        Fact_Sales,\n        Fact_Sales[sales_value] < 0 || Fact_Sales[retail_disc] < 0\n            || Fact_Sales[coupon_disc] < 0 || Fact_Sales[coupon_match_disc] < 0\n    )\n) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "f07409f5-6413-4702-b66d-3c28d49f9f24"
          },
          {
            "name": "Exact Duplicate Lines",
            "description": "DISTINCT of the whole table removes rows identical in every column, so the difference is the exact duplicates",
            "expression": "COUNTROWS ( Fact_Sales ) - COUNTROWS ( DISTINCT ( Fact_Sales ) ) + 0",
            "formatString": "#,0",
            "displayFolder": "5 Data quality",
            "lineageTag": "b12c798b-7db2-4b48-952e-867337065887"
          },
          {
            "name": "Loaded Rows (all)",
            "expression": "CALCULATE ( COUNTROWS ( Fact_Sales ), REMOVEFILTERS () )",
            "formatString": "#,0",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "99266664-4e9d-4113-8549-f90e3b85d31b"
          },
          {
            "name": "Sales (all)",
            "expression": "CALCULATE ( SUM ( Fact_Sales[sales_value] ), REMOVEFILTERS () )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "9c5973af-c4b2-48f9-9bd9-f5bdbd9a7b4b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Control Rows",
            "expression": "SUM ( Recon_Control[expected_rows] )",
            "formatString": "#,0",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "cd545ffc-7513-41d2-8f21-963fbcc54aff"
          },
          {
            "name": "Control Sales",
            "expression": "SUM ( Recon_Control[expected_sales_value] )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "418f99c9-4cb9-4d41-930f-328c670f0ee7",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Row Difference",
            "expression": "[Loaded Rows (all)] - [Control Rows]",
            "formatString": "#,0",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "91685008-fee0-4e84-a468-17dc7f91e0df"
          },
          {
            "name": "Sales Difference",
            "expression": "ROUND ( [Sales (all)] - [Control Sales], 2 )",
            "formatString": "\\$#,0.00;-\\$#,0.00;\\$#,0.00",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "d2aeffc1-8f75-448d-b677-c0f21ef6a50e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Actual (DQ rule)",
            "expression": "SWITCH (\n    SELECTEDVALUE ( DQ_Rules[RuleID] ),\n    \"DQ01\", [Zero-Quantity Lines],\n    \"DQ02\", [Free-Item Lines],\n    \"DQ03\", [Fuel Lines],\n    \"DQ04\", [Unknown-Product Lines],\n    \"DQ05\", [Negative-Value Lines],\n    \"DQ06\", [Exact Duplicate Lines],\n    \"DQ07\", CALCULATE ( COUNTROWS ( Dim_Date ), Dim_Date[IsClosed] = TRUE () ),\n    \"DQ08\", [Source Week Mismatch Lines],\n    BLANK ()\n)",
            "formatString": "#,0",
            "displayFolder": "6 Reconciliation",
            "lineageTag": "b24ee36c-7871-4605-aa00-1c499975c2c1"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
