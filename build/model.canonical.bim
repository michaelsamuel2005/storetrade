        ],
        "partitions": [
          {
            "name": "Dim_Store",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "// Query: Dim_Store   (Enable load: on). 457 stores. The extract has no store attributes (no region, format or size), only the id,\n// so store comparisons are by store, not by region. In the model: sort store_label by store_no.\nlet\n    Source = Table.Distinct(Table.SelectColumns(Transactions_Raw, {\"store_id\"})),\n    AddNo = Table.AddColumn(Source, \"store_no\", each Number.From([store_id]), Int64.Type),\n    AddLabel = Table.AddColumn(AddNo, \"store_label\", each \"Store \" & [store_id], type text),\n    Sorted = Table.Sort(AddLabel, {{\"store_no\", Order.Ascending}})\nin\n    Sorted"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
