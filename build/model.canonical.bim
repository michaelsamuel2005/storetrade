        ],
        "partitions": [
          {
            "name": "Recon_Control",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "// Query: Recon_Control   (Enable load: on). Control totals written by scripts/export_raw.R from the source object,\n// before any Power BI step. The Reconciliation page compares them with what the model loaded.\nlet\n    Source = Csv.Document(\n        File.Contents(Param_DataFolder & \"control_totals.csv\"),\n        [Delimiter = \",\", Columns = 13, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]\n    ),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Typed = Table.TransformColumnTypes(\n        Promoted,\n        {{\"source\", type text}, {\"expected_rows\", Int64.Type}, {\"expected_sales_value\", Currency.Type},\n         {\"expected_retail_disc\", Currency.Type}, {\"expected_coupon_disc\", Currency.Type},\n         {\"expected_coupon_match_disc\", Currency.Type}, {\"expected_baskets\", Int64.Type},\n         {\"expected_households\", Int64.Type}, {\"expected_stores\", Int64.Type}, {\"expected_products_sold\", Int64.Type},\n         {\"expected_product_rows\", Int64.Type}, {\"min_date\", type date}, {\"max_date\", type date}},\n        \"en-US\"\n    )\nin\n    Typed"
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
