        "kind": "m",
        "expression": "#date(2017, 1, 1) meta [IsParameterQuery = true, Type = \"Date\", IsParameterQueryRequired = true]",
        "lineageTag": "6a98b1e8-4bc8-464c-b565-dbfc58a1d2c3",
