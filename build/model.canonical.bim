          }
        ]
      },
      {
        "name": "Ref_ClosedDates",
        "kind": "m",
        "expression": "// Query: Ref_ClosedDates   (Enable load: off)\n// Calendar days with no transactions in the extract, found by comparing every calendar day with the dates in the data (rule DQ07).\n// Christmas Day: the stores were closed, so a zero is not a trading result. Add a row if a refresh brings new data.\nlet\n    Source = #table(\n        type table [Date = date, Reason = text],\n        {\n            {#date(2017, 12, 25), \"Christmas Day: no transactions in the extract\"}\n        }\n    )\nin\n    Source",
        "lineageTag": "8d052145-f16a-42ec-af9d-c7dcde742b11",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Transactions_Raw",
        "kind": "m",
        "expression": "// Query: Transactions_Raw   (Enable load: off)\n// Step 1 of the data flow: read the CSV as exported, set types. No rows are removed or changed here.\n// Keys are text on purpose (store_id \"330\" is a label, not a number; text keys also match the product file exactly).\nlet\n    Source = Csv.Document(\n        File.Contents(Param_DataFolder & \"transactions.csv\"),\n        [Delimiter = \",\", Columns = 11, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]\n    ),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Typed = Table.TransformColumnTypes(\n        Promoted,\n        {\n            {\"household_id\", type text}, {\"store_id\", type text}, {\"basket_id\", type text}, {\"product_id\", type text},\n            {\"quantity\", type number},\n            {\"sales_value\", Currency.Type}, {\"retail_disc\", Currency.Type},\n            {\"coupon_disc\", Currency.Type}, {\"coupon_match_disc\", Currency.Type},\n            {\"week\", Int64.Type}, {\"transaction_timestamp\", type datetime}\n        },\n        \"en-US\"\n    )\nin\n    Typed",
        "lineageTag": "c9402d8c-9d8c-4124-b14c-9a6a7eb9339c",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
      {
        "name": "Products_Raw",
        "kind": "m",
        "expression": "// Query: Products_Raw   (Enable load: off)\n// Staging query: reads products.csv and sets types, nothing else. Kept separate from Dim_Product so that no query both\n// reads a file and references another query (that combination triggers Power Query's Formula.Firewall error).\nlet\n    Source = Csv.Document(\n        File.Contents(Param_DataFolder & \"products.csv\"),\n        [Delimiter = \",\", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]\n    ),\n    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),\n    Typed = Table.TransformColumnTypes(\n        Promoted,\n        {{\"product_id\", type text}, {\"manufacturer_id\", type text}, {\"department\", type text}, {\"brand\", type text},\n         {\"product_category\", type text}, {\"product_type\", type text}, {\"package_size\", type text}},\n        \"en-US\"\n    )\nin\n    Typed",
        "lineageTag": "6181d1be-b596-4bcd-8f9c-9a9208dfa775",
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      }
    ],
    "annotations": [
      {
