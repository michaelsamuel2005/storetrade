      {
        "name": "Param_EndDate",
        "kind": "m",
        "expression": "#date(2017, 12, 31) meta [IsParameterQuery = true, Type = \"Date\", IsParameterQueryRequired = true]",
        "lineageTag": "872d4312-b4fa-45f3-af8f-4595fd5a01c4",
        "annotations": [
          {
